{
  "name": "lovarus-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server:build": "tsc server/index.ts --outDir server-dist --rootDir . --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck",
    "server": "npm run server:build && node --use-env-proxy --use-system-ca server-dist/server/index.js",
    "db:init": "npm run server:build && node server-dist/server/index.js --init-only",
    "test": "tsc server/oneCAdapter.test.ts --outDir test-dist --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck && node --test test-dist/server/oneCAdapter.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lucide-react": "^1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.6.3",
    "vite": "^8.1.5"
  }
}
